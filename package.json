{
  "name": "neo-nfc",
  "version": "1.0.0",
  "description": "NFC read/write for Neotropolis",
  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "lint": "eslint --fix . && tsc --noEmit",
    "prebuild": "npm run lint && rm -rf dist",
    "build": "swc --config-file .swcrc src -d dist --strip-leading-paths",
    "start": "node --enable-source-maps dist/app.js",
    "start:dev": "tsx watch src/app.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/gmathews/neo-nfc.git"
  },
  "keywords": [
    "nfc",
    "neotropolis"
  ],
  "author": "George Mathews <george@georgemathe.ws>",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/gmathews/neo-nfc/issues"
  },
  "homepage": "https://github.com/gmathews/neo-nfc#readme",
  "dependencies": {
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@libsql/client": "^0.17.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.4",
    "nconf": "^0.13.0",
    "neo-blessed": "^0.2.0",
    "nfc-pcsc": "^0.8.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.24",
    "@types/blessed": "^0.1.27",
    "@types/node": "^22.19.17",
    "@vitest/coverage-v8": "^4.1.3",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.3"
  }
}
